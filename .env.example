# ===========================================
# Valencia Gospel Singers - Environment Variables
# ===========================================

# Supabase Configuration (REQUIRED)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application URL (REQUIRED)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Access (REQUIRED)
# Comma-separated list of email addresses that can access /admin
# Example: ADMIN_EMAILS=director@valenciagospel.com,admin@valenciagospel.com
ADMIN_EMAILS=

# ===========================================
# Optional Configuration
# ===========================================

# Email Service (Resend)
# Required for: contact form confirmations, event announcements
# Get your API key from: https://resend.com
# RESEND_API_KEY=re_your-api-key
# RESEND_FROM_EMAIL=hola@valenciagospelsingers.com

# WhatsApp Contact
# Phone number for WhatsApp links (format: country code + number, no spaces or +)
# Example: 34612345678 (Spain)
# NEXT_PUBLIC_WHATSAPP_NUMBER=34600000000
